[Unit]
Description=acbridge - AllinSSL to Caddy certificate bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=acbridge
Group=acbridge
WorkingDirectory=/opt/acbridge
EnvironmentFile=/opt/acbridge/acbridge.env
ExecStart=/opt/acbridge/acbridge -addr 127.0.0.1:9443 -caddy http://127.0.0.1:2019 -cert-dir /var/lib/acbridge/certs -sync-interval 30 -http
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/acbridge/certs
CapabilityBoundingSet=
RestrictSUIDSGID=true
[Install]
WantedBy=multi-user.target
